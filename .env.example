# OpenAI (Task 4 embeddings, Task 7 fallback rerank, Task 10 generation)
OPENAI_API_KEY=sk-xxx

# Jina AI (Task 7 reranking; recommended when available)
JINA_API_KEY=jina_xxx

# PageIndex (Task 8 vectorless RAG; optional because local fallback exists)
PAGEINDEX_API_KEY=pi_xxx

# Core model settings
GENERATION_MODEL=gpt-5.5
GENERATION_FALLBACK_MODELS=gpt-4.1,gpt-4o-mini
GENERATION_TOP_K=5
RERANK_PROVIDER=auto
JINA_RERANK_MODEL=jina-reranker-v3

# Evaluation
# Default evaluation is deterministic/local. Enable only after installing deepeval.
EVAL_FRAMEWORK=
